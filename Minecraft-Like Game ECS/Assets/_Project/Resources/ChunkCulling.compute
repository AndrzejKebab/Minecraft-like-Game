#pragma kernel CullChunks

struct ChunkData {
    float3 center;
    uint vertexOffset;
    uint indexOffset;
    uint solidIndexCount;
    uint fluidIndexCount;
    uint padding;
};

struct IndirectArgs {
    uint indexCountPerInstance;
    uint instanceCount;
    uint startIndex;
    uint baseVertex;
    uint startInstance;
};

StructuredBuffer<ChunkData> _ChunkData;
RWStructuredBuffer<IndirectArgs> _SolidArgsBuffer;
RWStructuredBuffer<IndirectArgs> _FluidArgsBuffer;

float4 _Planes[6];
uint _ChunkCount;

bool IsInsideFrustum(float3 center, float3 extents) {
    for (int i = 0; i < 6; i++) {
        float3 normal = _Planes[i].xyz;
        float dist = _Planes[i].w;
        
        float r = extents.x * abs(normal.x) + extents.y * abs(normal.y) + extents.z * abs(normal.z);
        float d = dot(normal, center) + dist;
        
        if (d <= -r) return false;
    }
    return true;
}
[numthreads(64, 1, 1)]
void CullChunks(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _ChunkCount) return;
    
    ChunkData chunk = _ChunkData[id.x];
    
    float3 extents = float3(16, 16, 16); 
    float3 center = chunk.center;

    bool visible = IsInsideFrustum(center, extents);
    
    // Solid Buffer Logic
    IndirectArgs solidArgs;
    solidArgs.indexCountPerInstance = chunk.solidIndexCount;
    solidArgs.instanceCount = (visible && chunk.solidIndexCount > 0) ? 1 : 0;
    solidArgs.startIndex = chunk.indexOffset;
    solidArgs.baseVertex = chunk.vertexOffset;
    solidArgs.startInstance = id.x;
    _SolidArgsBuffer[id.x] = solidArgs;

    // Fluid Buffer Logic
    IndirectArgs fluidArgs;
    fluidArgs.indexCountPerInstance = chunk.fluidIndexCount;
    fluidArgs.instanceCount = (visible && chunk.fluidIndexCount > 0) ? 1 : 0;
    fluidArgs.startIndex = chunk.indexOffset + chunk.solidIndexCount;
    fluidArgs.baseVertex = chunk.vertexOffset; 
    fluidArgs.startInstance = id.x;
    _FluidArgsBuffer[id.x] = fluidArgs;
}